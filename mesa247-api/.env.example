APP_NAME="Mesa247 API"
DATABASE_URL=sqlite:///./mesa247.db
# MySQL local: primero docker compose up -d --wait
# DATABASE_URL=mysql+pymysql://mesa247:mesa247-local-only@127.0.0.1:3307/mesa247?charset=utf8mb4
# Aiven: usa el host/puerto/usuario de tu servicio y su certificado CA.
# DATABASE_SSL_CA=/ruta/absoluta/ca.pem
CREATE_TABLES=true
WEB_BASE_URL=http://localhost:5173
# Credenciales exclusivas de Docker local (si cambian, ajusta DATABASE_URL).
MYSQL_PASSWORD=mesa247-local-only
MYSQL_ROOT_PASSWORD=root-local-only
MYSQL_PORT=3307
